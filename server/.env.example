PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.qh4wdqn.mongodb.net/foodbridge?retryWrites=true&w=majority

JWT_SECRET=your_jwt_secret_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================================================
# NOTIFICATION SYSTEM CONFIGURATION (FoodBridge Multi-Channel Infrastructure)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Transactional Email Provider (Auto-detected: Resend > Brevo > SMTP > Sandbox)
# ------------------------------------------------------------------------------
# Option A: Resend API (Recommended)
# RESEND_API_KEY=re_1234567890abcdef

# Option B: Brevo (Sendinblue) API
# BREVO_API_KEY=xkeysib-1234567890abcdef

# Option C: Standard SMTP / Nodemailer (Gmail, SendGrid, Amazon SES, Custom SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=notifications@foodbridge.org
# SMTP_PASS=app_specific_password_here

# Common Email Sender Config
EMAIL_FROM_NAME="FoodBridge Platform"
EMAIL_FROM_ADDRESS=notifications@foodbridge.org

# ------------------------------------------------------------------------------
# 2. SMS Gateway Configuration (Auto-detected: India DLT > Twilio > Sandbox)
# ------------------------------------------------------------------------------
# Option A: India DLT Telephony Gateway (Fast2SMS / MSG91 HTTP Endpoint)
# INDIA_SMS_API_KEY=your_india_sms_api_key
# INDIA_SMS_GATEWAY_URL=https://api.msg91.com/api/v5/flow/
SMS_DLT_SENDER_ID=FDBRDG
SMS_DLT_ENTITY_ID=1101560000000000000

# Option B: Twilio SMS Gateway
# TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_PHONE_NUMBER=+1234567890

# ------------------------------------------------------------------------------
# 3. Notification Scheduler & Food Safety Heartbeat
# ------------------------------------------------------------------------------
# Polling interval for safe collection deadline warnings and auto-closure (in ms)
EXPIRY_SCHEDULER_INTERVAL_MS=300000
