# FoodBridge Environment Configuration Template

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
# Leave blank to automatically use the zero-configuration in-memory MongoDB instance for quick local demo.
MONGODB_URI=

# Authentication Secret
JWT_SECRET=foodbridge_super_secret_jwt_key_hackathon_2025_dev_mode

# AI Configuration (Optional)
# If provided, enables Google Gemini AI models. If omitted, smart rule-based fallback assistant is active.
GEMINI_API_KEY=

# Client Configuration
VITE_API_URL=http://localhost:5000

# ==============================================================================
# NOTIFICATION SYSTEM (Email, SMS, In-App)
# ==============================================================================
# Email Options: RESEND_API_KEY, BREVO_API_KEY, or SMTP_HOST / SMTP_USER / SMTP_PASS
# SMS Options: INDIA_SMS_API_KEY or TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN
EMAIL_FROM_NAME="FoodBridge Platform"
EMAIL_FROM_ADDRESS=notifications@foodbridge.org
SMS_DLT_SENDER_ID=FDBRDG
EXPIRY_SCHEDULER_INTERVAL_MS=300000
